+                  &native_len) != 0) {
+    XThread::SetLastError(0x2726);  // WSAEINVAL
+    return -1;
+  }
+  name->sin_family = 2;
+  name->sin_port = live::GuestPort(ntohs(native.sin_port));
+  name->sin_addr = live::Enabled() && native.sin_addr.s_addr == 0 ? ntohl(live::LocalAddress())
+                                                                  : ntohl(native.sin_addr.s_addr);
+  std::memset(name->x_sin_zero, 0, sizeof(name->x_sin_zero));
+  if (name_len) *name_len = 16;
+  return 0;
 }
 
