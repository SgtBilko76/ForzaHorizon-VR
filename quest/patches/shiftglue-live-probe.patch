+// ---------------------------------------------------------------------------
+// Overlapped receives, error codes (host errno -> WSA), used by WSARecvFrom,
+// WSAGetOverlappedResult, WSACancelOverlappedIO and recvfrom.
+namespace {
+
+constexpr uint32_t kStatusPending = 0x103;
+constexpr uint32_t kWsaIoIncomplete = 996;
+constexpr uint32_t kWsaIoPending = 997;
+constexpr uint32_t kWsaEWouldBlock = 10035;
+constexpr uint32_t kWsaECancelled = 10103;
+
+uint32_t WsaFromErrno(int error) {
+  switch (error) {
+#if !REX_PLATFORM_WIN32
+    case EWOULDBLOCK: return 10035;
+    case EMSGSIZE: return 10040;
+    case ECONNRESET: return 10054;
+    case ECONNREFUSED: return 10061;
+    case ENOTCONN: return 10057;
+    case EADDRINUSE: return 10048;
+    case EADDRNOTAVAIL: return 10049;
+    case ENETUNREACH: return 10051;
+    case EHOSTUNREACH: return 10065;
+    case EINTR: return 10004;
+    case EACCES: return 10013;
+    case EFAULT: return 10014;
+    case ENOTSOCK: return 10038;
+#endif
+    default: return 10022;  // WSAEINVAL
+  }
+}
+
+uint32_t HresultFromWsa(uint32_t error) {
+  return error ? (0x80070000u | (error & 0xFFFF)) : 0;
+}
+
+// XWSAOVERLAPPED: internal, internal_high, offset, offset_high, event.
+uint8_t* Overlapped(uint32_t guest) {
+  return REX_KERNEL_MEMORY()->TranslateVirtual<uint8_t*>(guest);
+}
+
+void SignalEvent(uint32_t handle, bool set) {
+  if (!handle) return;
+  auto ev = REX_KERNEL_OBJECTS()->LookupObject<XEvent>(handle);
+  if (!ev) return;
+  if (set) {
+    ev->Set(0, false);
+  } else {
+    ev->Reset();
+  }
+}
+
+struct ReceiveTarget {
+  uint32_t buffers = 0;  // guest XWSABUF array
+  uint32_t buffer_count = 0;
+  uint32_t from = 0;     // guest XSOCKADDR_IN
+  uint32_t from_len = 0;  // guest u32
+};
+
+// Copies one datagram into the guest buffers and address; returns its size.
+uint32_t DeliverDatagram(const ReceiveTarget& target, const uint8_t* data, uint32_t size,
+                         const sockaddr_in& from) {
+  uint32_t copied = 0;
+  for (uint32_t i = 0; i < target.buffer_count && copied < size; ++i) {
+    const auto* buffer = REX_KERNEL_MEMORY()->TranslateVirtual<uint8_t*>(target.buffers + i * 8);
+    const uint32_t length = memory::load_and_swap<uint32_t>(buffer);
+    const uint32_t pointer = memory::load_and_swap<uint32_t>(buffer + 4);
+    const uint32_t part = std::min(length, size - copied);
+    std::memcpy(REX_KERNEL_MEMORY()->TranslateVirtual<uint8_t*>(pointer), data + copied, part);
+    copied += part;
+  }
+  if (target.from) {
+    auto* address = REX_KERNEL_MEMORY()->TranslateVirtual<uint8_t*>(target.from);
+    memory::store_and_swap<uint16_t>(address + 0, 2);
+    memory::store_and_swap<uint16_t>(address + 2, live::GuestPort(ntohs(from.sin_port)));
+    memory::store_and_swap<uint32_t>(address + 4, ntohl(from.sin_addr.s_addr));
+    std::memset(address + 8, 0, 8);
+  }
+  if (target.from_len) {
+    memory::store_and_swap<uint32_t>(REX_KERNEL_MEMORY()->TranslateVirtual<uint8_t*>(target.from_len),
+                                     16);
+  }
+  return copied;
+}
+
+struct PendingReceive {
+  std::thread thread;
+  std::atomic<bool> cancel{false};
+  std::atomic<bool> done{false};
+};
+
+// Datagram counters, logged every 5 s while a session server is set.
+std::atomic<uint32_t> g_stat_sent{0}, g_stat_received{0}, g_stat_recv_calls{0},
+    g_stat_recv_now{0}, g_stat_recv_pending{0}, g_stat_recv_busy{0}, g_stat_result_ok{0},
+    g_stat_result_incomplete{0}, g_stat_result_error{0}, g_stat_cancelled{0};
+
+void LogNetStats() {
+  if (!live::Enabled()) return;
+  static std::atomic<int64_t> last{0};
+  const int64_t now = std::chrono::duration_cast<std::chrono::seconds>(
+                          std::chrono::steady_clock::now().time_since_epoch())
+                          .count();
+  int64_t previous = last.load();
+  if (now - previous < 5 || !last.compare_exchange_strong(previous, now)) return;
+  REXKRNL_INFO(
+      "LIVE net: sent {} received {} | recv calls {} (now {}, pending {}, busy {}) | results ok {} "
+      "incomplete {} error {} | cancelled {}",
+      g_stat_sent.load(), g_stat_received.load(), g_stat_recv_calls.load(), g_stat_recv_now.load(),
+      g_stat_recv_pending.load(), g_stat_recv_busy.load(), g_stat_result_ok.load(),
+      g_stat_result_incomplete.load(), g_stat_result_error.load(), g_stat_cancelled.load());
+}
+
+std::mutex g_receive_mutex;
+// Pending receives by (socket handle, guest overlapped): Winsock allows
+// several outstanding receives per socket.
+std::map<std::pair<uint32_t, uint32_t>, std::shared_ptr<PendingReceive>> g_receives;
+
+// Ends a socket's pending receives; cancelled ones report WSAECANCELLED.
+void StopReceive(uint32_t socket_handle) {
+  std::vector<std::shared_ptr<PendingReceive>> stopped;
+  {
+    std::lock_guard lock(g_receive_mutex);
+    for (auto it = g_receives.begin(); it != g_receives.end();) {
+      if (it->first.first == socket_handle) {
+        stopped.push_back(it->second);
+        it = g_receives.erase(it);
+      } else {
+        ++it;
+      }
+    }
+  }
+  for (auto& pending : stopped) {
+    pending->cancel = true;
+    if (pending->thread.joinable()) pending->thread.join();
+  }
+}
+
+// True while the receive on this overlapped is still running; joins it once
+// it has finished.
+bool ReceiveBusy(uint32_t socket_handle, uint32_t overlapped) {
+  std::shared_ptr<PendingReceive> finished;
+  {
+    std::lock_guard lock(g_receive_mutex);
+    auto it = g_receives.find({socket_handle, overlapped});
+    if (it == g_receives.end()) return false;
+    if (!it->second->done) return true;
+    finished = it->second;
+    g_receives.erase(it);
+  }
+  if (finished->thread.joinable()) finished->thread.join();
+  return false;
+}
+
+void StartReceive(uint32_t socket_handle, int fd, ReceiveTarget target, uint32_t overlapped) {
+  auto pending = std::make_shared<PendingReceive>();
+  const uint32_t event = memory::load_and_swap<uint32_t>(Overlapped(overlapped) + 16);
+  pending->thread = std::thread([pending, fd, target, overlapped, event]() {
+    std::vector<uint8_t> data(65536);
+    uint8_t* o = Overlapped(overlapped);
+    while (!pending->cancel) {
+      pollfd entry{fd, POLLIN, 0};
+      if (poll(&entry, 1, 20) <= 0) continue;
+      sockaddr_in from{};
+      socklen_t from_size = sizeof(from);
+      const auto got = recvfrom(fd, reinterpret_cast<char*>(data.data()), data.size(),
+                                MSG_DONTWAIT, reinterpret_cast<sockaddr*>(&from), &from_size);
+      if (got < 0) {
+        if (errno == EWOULDBLOCK || errno == EAGAIN || errno == EINTR) continue;
+        // done before the result is visible: the title may reissue at once.
+        pending->done = true;
+        memory::store_and_swap<uint32_t>(o + 0, HresultFromWsa(WsaFromErrno(errno)));
+        SignalEvent(event, true);
+        return;
+      }
+      const uint32_t size = DeliverDatagram(target, data.data(), uint32_t(got), from);
+      ++g_stat_received;
+      memory::store_and_swap<uint32_t>(o + 4, size);
+      memory::store_and_swap<uint32_t>(o + 8, 0);
+      pending->done = true;
+      std::atomic_thread_fence(std::memory_order_release);
+      memory::store_and_swap<uint32_t>(o + 0, 0);
+      SignalEvent(event, true);
+      return;
+    }
+    ++g_stat_cancelled;
+    pending->done = true;
+    memory::store_and_swap<uint32_t>(o + 0, HresultFromWsa(kWsaECancelled));
+    SignalEvent(event, true);
+  });
+  std::lock_guard lock(g_receive_mutex);
+  g_receives[{socket_handle, overlapped}] = pending;
+}
