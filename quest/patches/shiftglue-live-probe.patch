--- /dev/null
+++ b/src/kernel/xam/live_service.h
@@ -0,0 +1,86 @@
+#pragma once
+/**
+ * @file        kernel/xam/live_service.h
+ * @brief       A stand-in for the Xbox LIVE session service: sessions, QoS
+ *              data and XNet addresses for direct peer play
+ *
+ * The title's sessions are kept by a small server (live_server cvar,
+ * host:port, text protocol below). Peers talk directly over UDP: an XNADDR
+ * carries the instance's real IPv4 address (net_address), so XNet's secure
+ * addresses are the real ones.
+ *
+ * Protocol (one request per TCP connection, every reply ends with "END"):
+ *   CREATE <id> <ip> <flags> <public> <private> <attrs>
+ *   UPDATE <id> <filled public> <filled private>
+ *   DELETE <id>
+ *   QOS <id> <hex>              GETQOS <id>  -> Q <hex>
+ *   SEARCH <max>  /  GET <id>   -> S <id> <ip> <flags> <public> <private>
+ *                                    <filled public> <filled private> <attrs>
+ * ids are 16 hex digits, ip dotted, attrs "-" or a ';' list of
+ * C<id hex>=<value hex> (contexts) and P<id hex>=<bytes hex> (properties).
+ */
+
+#include <cstdint>
+#include <map>
+#include <string>
+#include <vector>
+
+namespace rex::kernel::xam::live {
+
+struct SessionRecord {
+  uint64_t id = 0;
+  uint32_t ip = 0;  // network order
+  uint32_t flags = 0;
+  uint32_t public_slots = 0;
+  uint32_t private_slots = 0;
+  uint32_t filled_public = 0;
+  uint32_t filled_private = 0;
+  std::map<uint32_t, uint32_t> contexts;
+  std::map<uint32_t, std::vector<uint8_t>> properties;
+};
+
+// True when a session server is configured.
+bool Enabled();
+
+// The address this instance announces (network order), net_address or the
+// first non-loopback IPv4 address.
+uint32_t LocalAddress();
+// True when net_address is a 127.x alias: sockets then bind to it so several
+// instances share one host.
+bool BindLocalAddress();
+// Guest port <-> host port (net_port_offset, for ports below 1024 that a
+// user process may not bind).
+uint16_t HostPort(uint16_t guest_port);
+uint16_t GuestPort(uint16_t host_port);
+
+// Fills a 36-byte guest XNADDR for an IPv4 address (network order); the MAC
+// and online id derive from the address so they differ per instance.
+void FillXnAddr(uint8_t* xnaddr, uint32_t ip);
+
+// The title's current user contexts and properties (XUserSetContext /
+// XUserSetProperty), sent along with a hosted session.
+void SetContext(uint32_t id, uint32_t value);
+void SetProperty(uint32_t id, const uint8_t* data, uint32_t size);
+
+bool CreateSession(uint64_t id, uint32_t flags, uint32_t public_slots, uint32_t private_slots);
+void UpdateSession(uint64_t id, uint32_t filled_public, uint32_t filled_private);
+void DeleteSession(uint64_t id);
+std::vector<SessionRecord> SearchSessions(uint32_t max_results);
+bool GetSession(uint64_t id, SessionRecord* out);
+void SetQosData(uint64_t id, const uint8_t* data, uint32_t size);
+std::vector<uint8_t> GetQosData(uint64_t id);
+
+// The profile's online XUID: 0009xxxxxxxxxxxx from the announced address, so
+// instances that share one save (same offline XUID) still differ online.
+// Without a session server, and until the title's first session (saves are
+// checked against the offline XUID at boot): the offline XUID.
+uint64_t OnlineXuid(uint64_t offline_xuid);
+
+// The session the title last created or joined (XNetInAddrToXnAddr's key id).
+void SetCurrentSession(uint64_t id);
+uint64_t CurrentSession();
+
+// Session ids hosted by this instance, so searches skip them.
+bool IsOwnSession(uint64_t id);
+
+}  // namespace rex::kernel::xam::live
