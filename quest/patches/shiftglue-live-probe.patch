+#include <rex/platform.h>
+
+#if REX_PLATFORM_WIN32
+#include <winsock2.h>
+#include <ws2tcpip.h>
+#else
+#include <arpa/inet.h>
+#include <ifaddrs.h>
+#include <netdb.h>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+#include <poll.h>
+#include <sys/socket.h>
+#include <unistd.h>
+#endif
+
+REXCVAR_DEFINE_STRING(live_server, "", "Kernel",
+                      "Session server host:port for online play (empty: off)");
+REXCVAR_DEFINE_STRING(net_address, "", "Kernel",
+                      "IPv4 address this instance announces to peers (empty: auto)");
+REXCVAR_DEFINE_INT32(net_port_offset, 0, "Kernel",
+                     "Added to the title's UDP/TCP ports on the host (unprivileged ports)");
+
+namespace rex::kernel::xam::live {
+namespace {
+
+std::mutex g_mutex;
+std::map<uint32_t, uint32_t> g_contexts;
+std::map<uint32_t, std::vector<uint8_t>> g_properties;
+std::set<uint64_t> g_own_sessions;
+uint64_t g_current_session = 0;
+std::atomic<bool> g_sessions_started{false};
+
+std::string Hex(const uint8_t* data, size_t size) {
+  static const char kDigits[] = "0123456789abcdef";
+  std::string out;
+  out.reserve(size * 2);
+  for (size_t i = 0; i < size; ++i) {
+    out.push_back(kDigits[data[i] >> 4]);
+    out.push_back(kDigits[data[i] & 15]);
+  }
+  return out;
+}
+
+std::vector<uint8_t> Unhex(const std::string& text) {
+  std::vector<uint8_t> out;
+  for (size_t i = 0; i + 1 < text.size(); i += 2) {
+    out.push_back(uint8_t(std::stoul(text.substr(i, 2), nullptr, 16)));
+  }
+  return out;
+}
+
+std::string IdText(uint64_t id) {
+  char text[17];
+  std::snprintf(text, sizeof(text), "%016llx", static_cast<unsigned long long>(id));
+  return text;
+}
+
+std::string IpText(uint32_t ip) {
+  in_addr address{};
+  address.s_addr = ip;
+  char text[INET_ADDRSTRLEN] = {};
+  inet_ntop(AF_INET, &address, text, sizeof(text));
+  return text;
+}
+
+uint32_t ParseIp(const std::string& text) {
+  in_addr address{};
+  return inet_pton(AF_INET, text.c_str(), &address) == 1 ? address.s_addr : 0;
+}
+
+std::string AttrsText() {
+  std::string out;
+  for (const auto& [id, value] : g_contexts) {
+    char item[32];
+    std::snprintf(item, sizeof(item), "C%x=%x;", id, value);
+    out += item;
+  }
+  for (const auto& [id, bytes] : g_properties) {
+    char item[16];
+    std::snprintf(item, sizeof(item), "P%x=", id);
+    out += item;
+    out += Hex(bytes.data(), bytes.size());
+    out += ';';
+  }
+  return out.empty() ? "-" : out;
+}
+
+void ParseAttrs(const std::string& text, SessionRecord* record) {
+  if (text == "-") return;
+  std::stringstream stream(text);
+  std::string item;
+  while (std::getline(stream, item, ';')) {
+    const size_t equals = item.find('=');
+    if (item.size() < 3 || equals == std::string::npos) continue;
+    const uint32_t id = uint32_t(std::stoul(item.substr(1, equals - 1), nullptr, 16));
+    const std::string value = item.substr(equals + 1);
+    if (item[0] == 'C') {
+      record->contexts[id] = uint32_t(std::stoul(value, nullptr, 16));
+    } else if (item[0] == 'P') {
+      record->properties[id] = Unhex(value);
+    }
+  }
+}
+
+bool ParseRecord(const std::string& line, SessionRecord* record) {
+  std::stringstream stream(line);
+  std::string tag, id, ip, attrs;
+  stream >> tag >> id >> ip >> record->flags >> record->public_slots >> record->private_slots >>
+      record->filled_public >> record->filled_private >> attrs;
+  if (tag != "S" || stream.fail()) return false;
+  record->id = std::stoull(id, nullptr, 16);
+  record->ip = ParseIp(ip);
+  ParseAttrs(attrs, record);
+  return true;
+}
+
+#if REX_PLATFORM_WIN32
+using NativeSocket = SOCKET;
+void CloseNative(NativeSocket s) { closesocket(s); }
+bool Valid(NativeSocket s) { return s != INVALID_SOCKET; }
+#else
+using NativeSocket = int;
+void CloseNative(NativeSocket s) { close(s); }
+bool Valid(NativeSocket s) { return s >= 0; }
+#endif
+
+// One request, reply lines up to "END". Empty on any failure.
+bool Request(const std::string& request, std::vector<std::string>* reply) {
+  const std::string server = REXCVAR_GET(live_server);
+  const size_t colon = server.rfind(':');
+  if (colon == std::string::npos) return false;
+  addrinfo hints{};
+  hints.ai_family = AF_INET;
+  hints.ai_socktype = SOCK_STREAM;
+  addrinfo* found = nullptr;
+  if (getaddrinfo(server.substr(0, colon).c_str(), server.substr(colon + 1).c_str(), &hints,
+                  &found) != 0 ||
+      !found) {
+    REXKRNL_WARN("LIVE server {} not resolved", server);
+    return false;
+  }
+  NativeSocket s = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+  bool ok = Valid(s);
+#if !REX_PLATFORM_WIN32
+  if (ok) {
+    timeval timeout{2, 0};
+    setsockopt(s, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout));
+    setsockopt(s, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout));
+  }
+#endif
+  ok = ok && connect(s, found->ai_addr, socklen_t(found->ai_addrlen)) == 0;
+  freeaddrinfo(found);
+  const std::string line = request + "\n";
+  ok = ok && send(s, line.data(), int(line.size()), 0) == int(line.size());
+  std::string data;
+  while (ok) {
+    char chunk[4096];
+    const auto got = recv(s, chunk, sizeof(chunk), 0);
+    if (got <= 0) break;
+    data.append(chunk, size_t(got));
+    if (data.size() >= 4 && (data.rfind("END\n") == data.size() - 4)) break;
+  }
+  if (Valid(s)) CloseNative(s);
+  if (!ok || data.rfind("END\n") == std::string::npos) {
+    REXKRNL_WARN("LIVE request '{}' failed", request.substr(0, request.find(' ')));
+    return false;
+  }
+  if (reply) {
+    std::stringstream stream(data);
+    std::string item;
+    while (std::getline(stream, item)) {
+      if (item == "END") break;
+      reply->push_back(item);
+    }
+  }
+  return true;
+}
+
+}  // namespace
+
+bool Enabled() {
+  return !REXCVAR_GET(live_server).empty();
+}
+
+uint32_t LocalAddress() {
+  static uint32_t cached = 0;
+  static std::string cached_for = "\x01";
+  std::lock_guard lock(g_mutex);
+  const std::string configured = REXCVAR_GET(net_address);
+  if (configured == cached_for) return cached;
+  cached_for = configured;
+  cached = configured.empty() ? 0 : ParseIp(configured);
+#if !REX_PLATFORM_WIN32
+  if (!cached) {
+    ifaddrs* list = nullptr;
+    if (getifaddrs(&list) == 0) {
+      for (ifaddrs* it = list; it; it = it->ifa_next) {
+        if (!it->ifa_addr || it->ifa_addr->sa_family != AF_INET) continue;
+        const uint32_t ip = reinterpret_cast<sockaddr_in*>(it->ifa_addr)->sin_addr.s_addr;
+        if ((ntohl(ip) >> 24) == 127) continue;
+        cached = ip;
+        break;
+      }
+      freeifaddrs(list);
+    }
+  }
+#endif
+  if (!cached) cached = htonl(INADDR_LOOPBACK);
+  REXKRNL_INFO("LIVE local address {}", IpText(cached));
+  return cached;
+}
+
+bool BindLocalAddress() {
+  return (ntohl(LocalAddress()) >> 24) == 127;
+}
+
+uint16_t HostPort(uint16_t guest_port) {
+  const int offset = REXCVAR_GET(net_port_offset);
+  if (!offset || !guest_port || guest_port + offset > 65535) return guest_port;
+  return uint16_t(guest_port + offset);
+}
+
+uint16_t GuestPort(uint16_t host_port) {
+  const int offset = REXCVAR_GET(net_port_offset);
+  if (!offset || host_port < offset) return host_port;
+  return uint16_t(host_port - offset);
+}
+
+void FillXnAddr(uint8_t* xnaddr, uint32_t ip) {
+  std::memset(xnaddr, 0, 36);
+  std::memcpy(xnaddr + 0, &ip, 4);  // ina, network order
+  std::memcpy(xnaddr + 4, &ip, 4);  // inaOnline
+  const uint8_t* b = reinterpret_cast<const uint8_t*>(&ip);
+  const uint8_t mac[6] = {0x02, 0x5A, b[0], b[1], b[2], b[3]};
+  std::memcpy(xnaddr + 10, mac, 6);
+  // abOnline: a stable per-address machine id.
+  xnaddr[16] = 0xFA;
+  xnaddr[17] = 0x00;
+  std::memcpy(xnaddr + 18, b, 4);
+}
+
+void SetContext(uint32_t id, uint32_t value) {
+  std::lock_guard lock(g_mutex);
+  g_contexts[id] = value;
+}
+
+void SetProperty(uint32_t id, const uint8_t* data, uint32_t size) {
+  std::lock_guard lock(g_mutex);
+  g_properties[id].assign(data, data + std::min<uint32_t>(size, 1024));
+}
+
+bool CreateSession(uint64_t id, uint32_t flags, uint32_t public_slots, uint32_t private_slots) {
+  std::string attrs;
+  {
+    std::lock_guard lock(g_mutex);
+    g_own_sessions.insert(id);
+    attrs = AttrsText();
+  }
+  if (!Enabled()) return false;
+  return Request("CREATE " + IdText(id) + " " + IpText(LocalAddress()) + " " +
+                     std::to_string(flags) + " " + std::to_string(public_slots) + " " +
+                     std::to_string(private_slots) + " " + attrs,
+                 nullptr);
+}
+
+void UpdateSession(uint64_t id, uint32_t filled_public, uint32_t filled_private) {
+  if (!Enabled()) return;
+  Request("UPDATE " + IdText(id) + " " + std::to_string(filled_public) + " " +
+              std::to_string(filled_private),
+          nullptr);
+}
+
+void DeleteSession(uint64_t id) {
+  {
+    std::lock_guard lock(g_mutex);
+    g_own_sessions.erase(id);
+  }
+  if (!Enabled()) return;
+  Request("DELETE " + IdText(id), nullptr);
+}
+
+std::vector<SessionRecord> SearchSessions(uint32_t max_results) {
+  std::vector<SessionRecord> out;
+  std::vector<std::string> lines;
+  if (!Enabled() || !Request("SEARCH " + std::to_string(max_results + 8), &lines)) return out;
+  for (const auto& line : lines) {
+    SessionRecord record;
+    if (!ParseRecord(line, &record) || IsOwnSession(record.id)) continue;
+    out.push_back(std::move(record));
+    if (out.size() >= max_results) break;
+  }
+  return out;
+}
+
+bool GetSession(uint64_t id, SessionRecord* out) {
+  std::vector<std::string> lines;
+  if (!Enabled() || !Request("GET " + IdText(id), &lines)) return false;
+  return !lines.empty() && ParseRecord(lines[0], out);
+}
+
+void SetQosData(uint64_t id, const uint8_t* data, uint32_t size) {
+  if (!Enabled()) return;
+  Request("QOS " + IdText(id) + " " + (size ? Hex(data, size) : std::string("-")), nullptr);
+}
+
+std::vector<uint8_t> GetQosData(uint64_t id) {
+  std::vector<std::string> lines;
+  if (!Enabled() || !Request("GETQOS " + IdText(id), &lines)) return {};
+  for (const auto& line : lines) {
+    if (line.size() > 2 && line[0] == 'Q' && line.substr(2) != "-") return Unhex(line.substr(2));
+  }
+  return {};
+}
+
+uint64_t OnlineXuid(uint64_t offline_xuid) {
+  // The save is checked against the profile at boot: keep the offline XUID
+  // until the title enters multiplayer (its first session).
+  if (!Enabled() || !g_sessions_started) return offline_xuid;
+  return 0x0009000000000000ull | (uint64_t(ntohl(LocalAddress())) << 8) | 0x01;
+}
+
+void SetCurrentSession(uint64_t id) {
+  g_sessions_started = true;
+  std::lock_guard lock(g_mutex);
+  g_current_session = id;
+}
+
+uint64_t CurrentSession() {
+  std::lock_guard lock(g_mutex);
+  return g_current_session;
+}
+
+bool IsOwnSession(uint64_t id) {
+  std::lock_guard lock(g_mutex);
+  return g_own_sessions.count(id) != 0;
+}
+
+}  // namespace rex::kernel::xam::live
