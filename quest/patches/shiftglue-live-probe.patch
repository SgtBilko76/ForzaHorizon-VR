+                             mapped_u32 name_len) {
+  NET_TRACE("getsockname", "");
+  auto socket = REX_KERNEL_OBJECTS()->LookupObject<XSocket>(socket_handle);
+  if (!socket || !name) {
+    XThread::SetLastError(0x2736);
+    return -1;
+  }
+  sockaddr_in native{};
+  socklen_t native_len = sizeof(native);
