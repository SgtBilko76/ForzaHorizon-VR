+// ---------------------------------------------------------------------------
+// Sessions against the stand-in LIVE service (../live_service.h). Only active
+// with live_server set; otherwise the stubs below answer as before.
+namespace {
+
+struct LocalSession {
+  uint64_t id = 0;
+  uint32_t flags = 0;
+  uint32_t public_slots = 0;
+  uint32_t private_slots = 0;
+  uint64_t nonce = 0;
+  uint32_t state = 0;  // XSESSION_STATE: lobby, registration, in game, reporting
+  bool host = false;
+  bool registered = false;
+  uint8_t info[0x3C] = {};
+  std::vector<uint64_t> members;
+};
+
+std::mutex g_sessions_mutex;
+std::map<uint32_t, LocalSession> g_sessions;  // by the guest session object
+
+constexpr uint32_t kSessionHost = 0x01;
+constexpr uint32_t kSessionMatchmaking = 0x08;
+
+uint32_t PropertySize(uint32_t id, uint32_t raw_size) {
+  switch ((id >> 28) & 0xF) {
+    case 1:  // int32
+    case 5:  // float
+      return 4;
+    case 2:  // int64
+    case 3:  // double
+    case 7:  // datetime
+      return 8;
+    default:  // unicode, binary
+      return raw_size;
+  }
+}
+
+// Writes header + results + contexts + properties into the caller's buffer.
+uint32_t WriteSearchResults(memory::Memory* memory, uint32_t buffer_ptr, uint32_t buffer_size,
+                            const std::vector<live::SessionRecord>& sessions) {
+  if (!buffer_ptr || buffer_size < 8) return 0;
+  auto* base = memory->TranslateVirtual<uint8_t*>(buffer_ptr);
+  std::memset(base, 0, 8);
+  uint32_t count = 0;
+  uint32_t used = 8 + uint32_t(sessions.size()) * 0x5C;
+  // Fit results and their attributes; drop what does not fit.
+  std::vector<uint32_t> attr_sizes;
+  for (const auto& s : sessions) {
+    uint32_t size = uint32_t(s.contexts.size()) * 8 + uint32_t(s.properties.size()) * 0x18;
+    for (const auto& [id, bytes] : s.properties) {
+      if (((id >> 28) & 0xF) == 4 || ((id >> 28) & 0xF) == 6) size += (uint32_t(bytes.size()) + 3) & ~3u;
+    }
+    attr_sizes.push_back(size);
+  }
+  while (count < sessions.size()) {
+    uint32_t need = 8 + (count + 1) * 0x5C;
+    for (uint32_t i = 0; i <= count; ++i) need += attr_sizes[i];
+    if (need > buffer_size) break;
+    ++count;
+  }
+  used = 8 + count * 0x5C;
+  memory::store_and_swap<uint32_t>(base + 0, count);
+  memory::store_and_swap<uint32_t>(base + 4, buffer_ptr + 8);
+  for (uint32_t i = 0; i < count; ++i) {
+    const auto& s = sessions[i];
+    uint8_t* r = base + 8 + i * 0x5C;
+    std::memset(r, 0, 0x5C);
+    memory::store_and_swap<uint64_t>(r + 0, s.id);
+    live::FillXnAddr(r + 8, s.ip);
+    for (int k = 0; k < 16; ++k) r[44 + k] = uint8_t(s.id >> ((k % 8) * 8)) ^ uint8_t(0x5A + k);
+    memory::store_and_swap<uint32_t>(r + 0x3C, s.public_slots - std::min(s.public_slots, s.filled_public));
+    memory::store_and_swap<uint32_t>(r + 0x40, s.private_slots - std::min(s.private_slots, s.filled_private));
+    memory::store_and_swap<uint32_t>(r + 0x44, s.filled_public);
+    memory::store_and_swap<uint32_t>(r + 0x48, s.filled_private);
+    // contexts
+    memory::store_and_swap<uint32_t>(r + 0x50, uint32_t(s.contexts.size()));
+    memory::store_and_swap<uint32_t>(r + 0x58, s.contexts.empty() ? 0 : buffer_ptr + used);
+    for (const auto& [id, value] : s.contexts) {
+      memory::store_and_swap<uint32_t>(base + used + 0, id);
+      memory::store_and_swap<uint32_t>(base + used + 4, value);
+      used += 8;
+    }
+    // properties, payloads after the array
+    memory::store_and_swap<uint32_t>(r + 0x4C, uint32_t(s.properties.size()));
+    memory::store_and_swap<uint32_t>(r + 0x54, s.properties.empty() ? 0 : buffer_ptr + used);
+    uint32_t payload = used + uint32_t(s.properties.size()) * 0x18;
+    for (const auto& [id, bytes] : s.properties) {
+      uint8_t* p = base + used;
+      std::memset(p, 0, 0x18);
+      const uint32_t type = (id >> 28) & 0xF;
+      memory::store_and_swap<uint32_t>(p + 0, id);
+      p[8] = uint8_t(type);
+      if (type == 4 || type == 6) {
+        memory::store_and_swap<uint32_t>(p + 16, uint32_t(bytes.size()));
+        memory::store_and_swap<uint32_t>(p + 20, buffer_ptr + payload);
+        std::memcpy(base + payload, bytes.data(), bytes.size());
+        payload += (uint32_t(bytes.size()) + 3) & ~3u;
+      } else {
+        std::memcpy(p + 16, bytes.data(), std::min<size_t>(bytes.size(), 8));
+      }
+      used += 0x18;
+    }
+    used = payload;
+  }
+  return count;
+}
+
+void PublishSession(const LocalSession& s) {
+  if (!s.host || !(s.flags & kSessionMatchmaking)) return;
+  live::CreateSession(s.id, s.flags, s.public_slots, s.private_slots);
+  live::UpdateSession(s.id, uint32_t(s.members.size()), 0);
+}
+
+}  // namespace
+
+// Returns true when handled; *result is the message result.
+static bool HandleLiveMessage(memory::Memory* memory, uint32_t message, uint32_t buffer_ptr,
+                              uint8_t* buffer, uint32_t buffer_length, X_HRESULT* result) {
+  auto u32at = [&](uint32_t offset) { return memory::load_and_swap<uint32_t>(buffer + offset); };
+  *result = X_E_SUCCESS;
+  switch (message) {
+    case 0x000B0006:  // XUserSetContext: recorded, then the stub below
+      live::SetContext(u32at(16), u32at(20));
+      return false;
+    case 0x000B0007: {  // XUserSetProperty
+      const uint32_t id = u32at(16);
+      const uint32_t size = u32at(20);
+      const uint32_t ptr = u32at(24);
+      if (ptr) {
+        live::SetProperty(id, memory->TranslateVirtual<uint8_t*>(ptr), PropertySize(id, size));
+      }
+      return false;
+    }
+    case 0x000B0010: {  // XSessionCreate
+      const uint32_t obj = u32at(0);
+      LocalSession s;
+      s.flags = u32at(4);
+      s.public_slots = u32at(8);
+      s.private_slots = u32at(12);
+      const uint32_t info_ptr = u32at(20);
+      const uint32_t nonce_ptr = u32at(24);
+      s.host = (s.flags & kSessionHost) != 0;
+      uint8_t* info = info_ptr ? memory->TranslateVirtual<uint8_t*>(info_ptr) : nullptr;
+      std::random_device random;
+      auto next = [&random]() { return (uint64_t(random()) << 32) | uint64_t(random()); };
+      if (s.host && info) {
+        s.id = (uint64_t(0x80) << 56) | (next() & 0x00FFFFFFFFFFFFFFull);
+        memory::store_and_swap<uint64_t>(info + 0, s.id);
+        live::FillXnAddr(info + 8, live::LocalAddress());
+        for (int i = 0; i < 16; ++i) info[44 + i] = uint8_t(random());
+        s.nonce = next();
+        if (nonce_ptr) memory::store_and_swap<uint64_t>(memory->TranslateVirtual<uint8_t*>(nonce_ptr), s.nonce);
+      } else if (info) {
+        s.id = memory::load_and_swap<uint64_t>(info);  // joining a found session
+      }
+      if (info) std::memcpy(s.info, info, sizeof(s.info));
+      live::SetCurrentSession(s.id);
+      REXKRNL_INFO("LIVE XSessionCreate {} {:016X} flags {:08X} slots {}+{}",
+                   s.host ? "host" : "join", s.id, s.flags, s.public_slots, s.private_slots);
+      std::lock_guard lock(g_sessions_mutex);
+      g_sessions[obj] = s;
+      if (s.host && (s.flags & kSessionMatchmaking)) {
+        g_sessions[obj].registered = true;
+        PublishSession(g_sessions[obj]);
+      }
+      return true;
+    }
+    case 0x000B0011: {  // XSessionDelete
+      std::lock_guard lock(g_sessions_mutex);
+      auto it = g_sessions.find(u32at(0));
+      if (it != g_sessions.end()) {
+        if (it->second.registered) live::DeleteSession(it->second.id);
+        REXKRNL_INFO("LIVE XSessionDelete {:016X}", it->second.id);
+        g_sessions.erase(it);
+      }
+      return true;
+    }
+    case 0x000B0012:    // XSessionJoinLocal / JoinRemote
+    case 0x000B0013: {  // XSessionLeaveLocal / LeaveRemote
+      const bool join = message == 0x000B0012;
+      const uint32_t count = std::min<uint32_t>(u32at(4), 16);
+      const uint32_t xuids_ptr = u32at(8);
+      std::vector<uint64_t> xuids;
+      for (uint32_t i = 0; i < count; ++i) {
+        xuids.push_back(xuids_ptr ? memory::load_and_swap<uint64_t>(
+                                        memory->TranslateVirtual<uint8_t*>(xuids_ptr + i * 8))
+                                  : live::OnlineXuid(REX_KERNEL_STATE()->user_profile()->xuid()) + i);
+      }
+      std::lock_guard lock(g_sessions_mutex);
+      auto it = g_sessions.find(u32at(0));
+      if (it == g_sessions.end()) return true;
+      auto& members = it->second.members;
+      for (uint64_t xuid : xuids) {
+        auto found = std::find(members.begin(), members.end(), xuid);
+        if (join && found == members.end()) members.push_back(xuid);
+        if (!join && found != members.end()) members.erase(found);
+      }
+      REXKRNL_INFO("LIVE XSession{}{} {:016X} -> {} members", join ? "Join" : "Leave",
+                   xuids_ptr ? "Remote" : "Local", it->second.id, members.size());
+      if (it->second.registered) live::UpdateSession(it->second.id, uint32_t(members.size()), 0);
+      return true;
+    }
+    case 0x000B0014:    // XSessionStart
+    case 0x000B0015: {  // XSessionEnd
+      std::lock_guard lock(g_sessions_mutex);
+      auto it = g_sessions.find(u32at(0));
+      if (it != g_sessions.end()) {
+        it->second.state = message == 0x000B0014 ? 2 : 3;
+        REXKRNL_INFO("LIVE XSession{} {:016X}", message == 0x000B0014 ? "Start" : "End",
+                     it->second.id);
+      }
+      return true;
+    }
+    case 0x000B0018: {  // XSessionModify
+      std::lock_guard lock(g_sessions_mutex);
+      auto it = g_sessions.find(u32at(0));
+      if (it != g_sessions.end()) {
+        it->second.flags = (it->second.flags & kSessionHost) | (u32at(4) & ~kSessionHost);
+        it->second.public_slots = u32at(8);
+        it->second.private_slots = u32at(12);
+        REXKRNL_INFO("LIVE XSessionModify {:016X} flags {:08X} slots {}+{}", it->second.id,
+                     it->second.flags, it->second.public_slots, it->second.private_slots);
+        if (it->second.registered) PublishSession(it->second);
+      }
+      return true;
+    }
+    case 0x000B0016:    // XSessionSearch
+    case 0x000B001C: {  // XSessionSearchEx
+      const uint32_t num_results = u32at(8);
+      const auto sessions = live::SearchSessions(std::max<uint32_t>(num_results, 1));
+      const uint32_t count = WriteSearchResults(memory, u32at(28), u32at(24), sessions);
+      REXKRNL_INFO("LIVE XSessionSearch max {} -> {} found, {} returned", num_results,
+                   sessions.size(), count);
+      return true;
+    }
+    case 0x000B001B: {  // XSessionSearchByID { user, XNKID, size, results }
+      const uint64_t id = memory::load_and_swap<uint64_t>(buffer + 4);
+      std::vector<live::SessionRecord> sessions(1);
+      if (!live::GetSession(id, &sessions[0])) sessions.clear();
+      const uint32_t count = WriteSearchResults(memory, u32at(16), u32at(12), sessions);
+      REXKRNL_INFO("LIVE XSessionSearchByID {:016X} -> {}", id, count);
+      return true;
+    }
+    case 0x000B001D: {  // XSessionGetDetails
+      std::lock_guard lock(g_sessions_mutex);
+      auto it = g_sessions.find(u32at(0));
+      const uint32_t size = u32at(4);
+      const uint32_t details_ptr = u32at(8);
+      if (it == g_sessions.end() || !details_ptr || size < 0x80) {
+        *result = X_E_INVALIDARG;
+        return true;
+      }
+      const auto& s = it->second;
+      uint8_t* d = memory->TranslateVirtual<uint8_t*>(details_ptr);
+      std::memset(d, 0, 0x80);
+      const uint32_t members = uint32_t(s.members.size());
+      const uint32_t returned = std::min<uint32_t>(members, (size - 0x80) / 0x10);
+      memory::store_and_swap<uint32_t>(d + 0x0C, s.flags);
+      memory::store_and_swap<uint32_t>(d + 0x10, s.public_slots);
+      memory::store_and_swap<uint32_t>(d + 0x14, s.private_slots);
+      memory::store_and_swap<uint32_t>(d + 0x18, s.public_slots - std::min(s.public_slots, members));
+      memory::store_and_swap<uint32_t>(d + 0x1C, s.private_slots);
+      memory::store_and_swap<uint32_t>(d + 0x20, members);
+      memory::store_and_swap<uint32_t>(d + 0x24, returned);
+      memory::store_and_swap<uint32_t>(d + 0x28, s.state);
+      memory::store_and_swap<uint64_t>(d + 0x30, s.nonce);
+      std::memcpy(d + 0x38, s.info, sizeof(s.info));
+      memory::store_and_swap<uint32_t>(d + 0x7C, returned ? details_ptr + 0x80 : 0);
+      for (uint32_t i = 0; i < returned; ++i) {
+        memory::store_and_swap<uint64_t>(d + 0x80 + i * 16, s.members[i]);
+        memory::store_and_swap<uint32_t>(d + 0x88 + i * 16, i == 0 && s.host ? 0 : 0xFE);
+        memory::store_and_swap<uint32_t>(d + 0x8C + i * 16, 0);
+      }
+      return true;
+    }
+    default:
+      return false;
+  }
+}
